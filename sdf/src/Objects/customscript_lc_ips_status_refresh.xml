  <isinactive>F</isinactive>
  <name>LC NCHL Payment Status Refresh</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <scriptfile>[/SuiteScripts/rdnchl/ips_status_refresh_ss.js]</scriptfile>
  <!-- The deployment customdeploy_lc_ips_status_refresh (Scheduled, every hour from 6:00 am) is maintained in
       the NetSuite UI and deliberately left out of this file: SDF cannot express the schedule in this account's
       time zone (UTC+5:45), and including the deployment here would reset it to Not Scheduled on every deploy. -->
</scheduledscript>
